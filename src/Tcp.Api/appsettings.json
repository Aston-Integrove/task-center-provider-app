{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    "ApplicationId": "integrove",
    "ApplicationInstanceId": "tcproto",
    "TenantId": "dev",
    "PublicBaseUrl": "",
    "DefaultLanguage": "en-US"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "KeyVault": {
    "Uri": ""
  },
  "Diagnostics": {
    "RequestLogEnabled": true,
    "RequestLogSize": 500
  },
  "Admin": {
    "BasicUser": "admin"
  },
  "OAuth": {
    "Clients": [
      {
        "ClientId": "tc-tech",
        "SecretName": "oauth-client-tc-tech",
        "AllowedGrants": [
          "client_credentials"
        ],
        "AllowedScopes": [
          "spi.tech"
        ],
        "DefaultScopes": [
          "spi.tech"
        ],
        "Audience": "tc-provider",
        "TokenLifetimeSeconds": 900
      },
      {
        "ClientId": "tc-pp",
        "SecretName": "oauth-client-tc-pp",
        "AllowedGrants": [
          "urn:ietf:params:oauth:grant-type:jwt-bearer"
        ],
        "AllowedScopes": [
          "spi.user"
        ],
        "DefaultScopes": [
          "spi.user"
        ],
        "Audience": "tc-provider",
        "TokenLifetimeSeconds": 600
      },
      {
        "ClientId": "ips-scim",
        "SecretName": "oauth-client-ips-scim",
        "AllowedGrants": [
          "client_credentials"
        ],
        "AllowedScopes": [
          "scim"
        ],
        "DefaultScopes": [
          "scim"
        ],
        "Audience": "tc-provider-scim",
        "TokenLifetimeSeconds": 900
      }
    ],
    "TrustedAssertionIssuers": [],
    "UserIdClaims": [],
    "SigningKeySecretName": "token-signing-key",
    "TokenRateLimitPerMinute": 60
  },
  "Saml": {
    "Enabled": false
  },
  "Scim": {
    "RequireGlobalUserId": true,
    "UseGlobalUserIdAsId": false,
    "GlobalUserIdSources": [],
    "AllowBasic": false,
    "PatchReturnsNoContent": false,
    "AcceptGlobalUserIdAsMemberValue": false,
    "DefaultCount": 100,
    "MaxCount": 1000
  }
}